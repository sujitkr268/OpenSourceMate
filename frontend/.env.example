# ==============================================================================
# OpenSourceMate Frontend Environment Variables (Next.js)
# ==============================================================================
# Copy this file to .env.local:
#   PowerShell: Copy-Item .env.example .env.local
#   Bash:       cp .env.example .env.local
#
# Note: Next.js loads environment variables from .env, .env.development, and
# .env.local. For local development, copying to .env.local is recommended as it
# takes precedence and is excluded from source control by default.
# Variables exposed to the browser MUST start with the NEXT_PUBLIC_ prefix.
# ==============================================================================

# Backend API Base URL
# Optional for local development; defaults to http://localhost:8000 if unset.
# Points the Next.js frontend to the running FastAPI backend server for API requests.
NEXT_PUBLIC_API_URL=http://localhost:8000
