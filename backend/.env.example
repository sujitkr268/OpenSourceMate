# ==============================================================================
# OpenSourceMate Backend Environment Variables (FastAPI)
# ==============================================================================
# Copy this file to .env:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# NOTE: The backend framework is FastAPI (using Pydantic Settings), not Django.
# All settings have safe development defaults. Zero credentials are required
# for basic local startup. In production (ENVIRONMENT=production), SECRET_KEY
# MUST be set to a secure string (min 16 chars) or startup fails loudly.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode
# ------------------------------------------------------------------------------
# Target runtime environment: 'development', 'production', or 'testing'.
# In 'development', DEBUG defaults to True and a built-in dev SECRET_KEY is allowed.
# In 'production', DEBUG defaults to False and SECRET_KEY is strictly required.
ENVIRONMENT=development

# Enable or disable FastAPI debug mode.
# Optional. In development, defaults to True. In production, must be False.
DEBUG=True

# Application secret key used for cryptographic signing, session safety, and tokens.
# Development: Optional. Defaults to a dev key if left blank.
# Production: REQUIRED! Must be at least 16 characters long. Server fails loudly if unset or default.
# Example production key: opensourcemate_prod_sec_984f1b2c894e7732a1
SECRET_KEY=dev-insecure-secret-key-change-in-production

# ------------------------------------------------------------------------------
# 2. Host & Security Restrictions
# ------------------------------------------------------------------------------
# JSON array or comma-separated list of allowed HTTP Host header domains (TrustedHostMiddleware).
# Optional. Safe development default: ["*"] (allows all hosts in development).
# Production example: ["api.opensourcemate.com", "opensourcemate.com"]
ALLOWED_HOSTS=["*"]

# ------------------------------------------------------------------------------
# 3. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# JSON array or comma-separated list of allowed origin URLs for CORS requests.
# Optional. Default includes standard local and production frontend URLs.
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://open-source-mate-tawny.vercel.app"]

# Whether to allow credentials (cookies, authorization headers) across CORS.
# Optional. Default: False
CORS_ALLOW_CREDENTIALS=False

# JSON array or comma-separated list of allowed HTTP methods for CORS.
# Optional. Default: ["*"]
CORS_ALLOW_METHODS=["*"]

# JSON array or comma-separated list of allowed HTTP request headers for CORS.
# Optional. Default: ["*"]
CORS_ALLOW_HEADERS=["*"]

# ------------------------------------------------------------------------------
# 4. GitHub API Integration (Optional)
# ------------------------------------------------------------------------------
# Personal access token to elevate GitHub REST API rate limits (from 60 to 5,000 req/hr).
# Optional. Leave blank for unauthenticated requests during local development.
# Obtain a token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# In-memory TTL cache duration in seconds for GitHub profiles and repository data.
# Optional. Default: 300 (5 minutes). Set to 0 to disable in-memory caching.
GITHUB_CACHE_TTL=300

# GitHub repository pagination configuration (Issue #129)
# Maximum number of repository pages to fetch per user analysis.
# Optional. Default: 3
GITHUB_MAX_REPO_PAGES=3

# Items per page requested from GitHub API (maximum allowed by GitHub is 100).
# Optional. Default: 100
GITHUB_REPOS_PER_PAGE=100

# Sensible upper bound on the total number of repositories analyzed per profile.
# Optional. Default: 300
GITHUB_MAX_REPOS_CAP=300

# ------------------------------------------------------------------------------
# 5. AI Analysis Configuration (Optional)
# ------------------------------------------------------------------------------
# OpenAI API key used for deep-dive issue analysis (/api/ai/analyze-issue).
# Note: The codebase reads AI_API_KEY (not OPENAI_API_KEY).
# Optional. Leave blank to use graceful non-AI rule-based match recommendations.
# Obtain a key at: https://platform.openai.com/api-keys
AI_API_KEY=

# OpenAI model identifier to use when AI analysis is invoked.
# Optional. Default: gpt-4o-mini
AI_MODEL=gpt-4o-mini

# Google Gemini API key (optional fallback for AI services in AISettings).
# Note: The codebase defines GEMINI_API_KEY (not GOOGLE_API_KEY).
# Optional. Leave blank if not using Gemini.
GEMINI_API_KEY=

# Maximum word count for AI-generated issue match explanations.
# Optional. Default: 50
OSM_MAX_EXPLANATION_WORDS=50

# ------------------------------------------------------------------------------
# 6. Semantic Embeddings Matching (Optional)
# ------------------------------------------------------------------------------
# Optional flag to enable sentence-transformers embedding similarity for issue matching.
# Requires optional dependencies from requirements-optional.txt.
# Optional. Default: false
OSM_USE_EMBEDDINGS=false
