# ==============================================================================
# OpenSourceMate Backend Environment Variables (FastAPI)
# ==============================================================================
# Copy this file to .env:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# All settings have safe development defaults. Zero credentials are required
# for basic local startup. In production (ENVIRONMENT=production), SECRET_KEY
# MUST be set to a secure string (min 16 chars) or startup fails loudly.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode
# ------------------------------------------------------------------------------
# Target environment: 'development', 'production', or 'testing'.
# In 'development', DEBUG defaults to True and a built-in dev SECRET_KEY is allowed.
# In 'production', DEBUG defaults to False and SECRET_KEY is strictly required.
ENVIRONMENT=development

# Enable or disable FastAPI debug mode.
# Optional. In development, defaults to True. In production, must be False.
DEBUG=True

# Application secret key used for cryptographic signing, session safety, and tokens.
# Development: Defaults to an insecure development key if left blank.
# Production: REQUIRED! Must be at least 16 characters long. Server fails loudly if unset.
# Example production key: opensourcemate_prod_sec_984f1b2c894e7732a1
SECRET_KEY=dev-insecure-secret-key-change-in-production

# ------------------------------------------------------------------------------
# 2. Host & Security Restrictions
# ------------------------------------------------------------------------------
# Comma-separated list of allowed HTTP Host header domains (TrustedHostMiddleware).
# Default: '*' (allows all hosts in development).
# Production example: api.opensourcemate.com,opensourcemate.com
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# 3. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origin URLs for CORS requests.
# Multiple origins can be separated by commas or specified as JSON list.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://open-source-mate-tawny.vercel.app

# Whether to allow credentials (cookies, authorization headers) across CORS.
# Default: False
CORS_ALLOW_CREDENTIALS=False

# Comma-separated list of allowed HTTP methods for CORS.
# Default: '*'
CORS_ALLOW_METHODS=*

# Comma-separated list of allowed HTTP request headers for CORS.
# Default: '*'
CORS_ALLOW_HEADERS=*

# ------------------------------------------------------------------------------
# 4. GitHub API Integration (Optional)
# ------------------------------------------------------------------------------
# Personal access token to elevate GitHub REST API rate limits (from 60 to 5,000 req/hr).
# Leave blank for unauthenticated requests during local development.
# Obtain a token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# In-memory TTL cache duration in seconds for GitHub profiles and repository data.
# Default: 300 (5 minutes). Set to 0 to disable in-memory caching.
GITHUB_CACHE_TTL=300

# ------------------------------------------------------------------------------
# 5. AI Analysis Configuration (Optional)
# ------------------------------------------------------------------------------
# OpenAI API key used for deep-dive issue analysis (/api/ai/analyze-issue).
# Leave blank to use graceful non-AI rule-based match recommendations.
# Obtain a key at: https://platform.openai.com/api-keys
AI_API_KEY=

# OpenAI model identifier to use when AI analysis is invoked.
# Default: gpt-4o-mini
AI_MODEL=gpt-4o-mini
